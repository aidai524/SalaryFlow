{
  "name": "decash",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "api"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "npm run dev -w api",
    "build": "tsc -b && vite build",
    "build:api": "npm run build -w api",
    "check": "tsc -b --pretty false",
    "check:api": "npm run check -w api",
    "verify": "npm run check && npm run check:api && npm run build",
    "test": "vitest run",
    "verify:full": "npm run verify && npm run test:api:smoke",
    "test:api:smoke": "node api/scripts/run-smoke.mjs",
    "db:migrate": "npm run db:migrate -w api",
    "deploy:api": "npm run deploy -w api",
    "deploy:web": "npx --prefix api wrangler pages deploy",
    "deploy": "npm run deploy:api && npm run deploy:web"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@near-wallet-selector/core": "^10.1.4",
    "@near-wallet-selector/hot-wallet": "^10.1.4",
    "@near-wallet-selector/meteor-wallet": "^10.1.4",
    "@near-wallet-selector/modal-ui": "^10.1.4",
    "@near-wallet-selector/my-near-wallet": "^10.1.4",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@solana/spl-token": "^0.4.15",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-wallets": "^0.19.38",
    "@solana/web3.js": "^1.98.4",
    "@tanstack/react-query": "^5.101.4",
    "big.js": "^7.0.1",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.468.0",
    "motion": "^13.0.0",
    "near-api-js": "^5.1.1",
    "process": "^0.11.10",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.2",
    "react-toastify": "^11.1.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.55.11",
    "wagmi": "^2.19.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/big.js": "^7.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vitest": "^4.1.10"
  }
}
