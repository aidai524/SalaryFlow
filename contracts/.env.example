# Copy to contracts/.env (gitignored). Foundry loads this automatically.
# Deployer EOA private key. Needs gas on each target chain (ETH on Ethereum/Arbitrum, BNB on BNB Chain).
PRIVATE_KEY=0x

# RPCs
ARB_RPC_URL=https://arb1.arbitrum.io/rpc
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
BSC_RPC_URL=https://bsc-dataseed.binance.org

# Optional. Required only for `forge script ... --verify`
ARBISCAN_API_KEY=
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
